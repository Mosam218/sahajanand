{
  "name": "sahajanand-electronics-api",
  "version": "1.0.0",
  "description": "REST API for Sahajanand Electronics and Refrigeration LLP E-commerce",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --forceExit --detectOpenHandles",
    "test:coverage": "jest --forceExit --detectOpenHandles --coverage",
    "lint": "eslint src/ tests/ --ext .js",
    "lint:fix": "eslint src/ tests/ --ext .js --fix",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\"",
    "make-admin": "node scripts/make-admin.js",
    "import:catalogue": "node scripts/import-catalogue.js",
    "dev:local": "node scripts/dev-local.js"
  },
  "keywords": [
    "ecommerce",
    "electronics",
    "api"
  ],
  "author": "Sahajanand Electronics and Refrigeration LLP",
  "license": "ISC",
  "dependencies": {
    "cloudinary": "^2.11.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.4.0",
    "firebase-admin": "^13.0.0",
    "helmet": "^7.1.0",
    "hpp": "^0.2.3",
    "mongoose": "^8.7.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.0.15",
    "razorpay": "^2.9.4",
    "slugify": "^1.6.6",
    "winston": "^3.14.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-node": "^11.1.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.0.1",
    "nodemon": "^3.1.7",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000,
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js",
      "!src/config/**"
    ],
    "setupFiles": [
      "<rootDir>/tests/env.js"
    ],
    "maxWorkers": 2
  }
}
