# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=5000

# Comma-separated storefront origins allowed to call this API (CORS)
CLIENT_URLS=http://localhost:5173

# Public URL of this API (used for links to locally stored uploads)
PUBLIC_API_URL=http://localhost:5000

# MongoDB connection string (MongoDB Atlas → Connect → Drivers)
MONGODB_URI=

# ── Firebase Authentication (required) ──────────────────────────────
# Firebase Console → Project settings → Service accounts → Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the quotes; newlines written as \n
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Local development only: use the Firebase Auth emulator instead of a service
# account (then FIREBASE_CLIENT_EMAIL / FIREBASE_PRIVATE_KEY are not needed).
# Refused when NODE_ENV=production.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# ── Admin access ────────────────────────────────────────────────────
# Accounts with these (verified) email addresses become admin / super admin
# when they sign in. Comma-separated. See also: npm run make-admin
ADMIN_EMAILS=
SUPER_ADMIN_EMAILS=

# ── Razorpay (optional) ─────────────────────────────────────────────
# Leave all three empty to switch online payment off (cash on delivery only).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Cloudinary (optional) ───────────────────────────────────────────
# Leave empty to keep uploaded images on this server's disk (/uploads).
# Set all three on hosts whose disk is wiped on redeploy (Render, Railway...).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Business defaults ───────────────────────────────────────────────
# Only used the first time the server starts, to create the store settings.
# After that, change them in Admin → Settings.
ENABLE_COD=true
DELIVERY_CHARGE=500
FREE_DELIVERY_ABOVE=10000
# true: product prices already include GST. false: GST_PERCENT is added at checkout.
GST_INCLUSIVE=true
GST_PERCENT=18

# ── Email (optional) ────────────────────────────────────────────────
# Without SMTP settings no emails are sent (orders still work).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
# Where new-enquiry / refund / stock alerts go (default: the admin emails above)
ADMIN_ALERT_EMAIL=
