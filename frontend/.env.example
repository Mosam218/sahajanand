# Copy to .env and fill in. Everything here ends up in the browser bundle:
# never put a secret (Razorpay secret, Firebase service account, database URL)
# in this file. Those belong in backend/.env only.

# Backend API (must end in /api)
VITE_API_URL=http://localhost:5000/api

# Public address of this website (used for canonical links and sharing tags)
VITE_SITE_URL=

# Firebase Authentication: Firebase Console → Project settings → Your apps → Web app.
# These identify the project; they are safe to publish.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Razorpay Standard Checkout Key ID (public key only)
VITE_RAZORPAY_KEY_ID=

# Local development only: use the Firebase Auth emulator (see README).
# Leave empty for production builds.
# VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
